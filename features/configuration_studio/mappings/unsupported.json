{
    "ignore": [
        "service timestamps",
        "service password-encryption",
        "boot-start-marker",
        "boot-end-marker",
        "archive",
        "logging buffered",
        "switchport trunk encapsulation dot1q",
        "spanning-tree extend system-id"
    ],
    "unsupported": [
        "monitor session",
        "macro auto execute",
        "errdisable recovery",
        "fabricpath",
        "vpc",
        "feature interface-vlan"
    ]
}
