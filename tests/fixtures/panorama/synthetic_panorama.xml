<?xml version="1.0"?>
<config version="11.2.0" urldb="paloaltonetworks">
  <mgt-config>
    <users>
      <entry name="demo-admin">
        <phash>CANARYphash$1$abcdefgh$ZZZZZZZZZZZZZZ</phash>
        <permissions><role-based><superuser>yes</superuser></role-based></permissions>
      </entry>
      <entry name="demo-ops">
        <authentication-profile>demo-radius</authentication-profile>
        <permissions><role-based><superreader>yes</superreader></role-based></permissions>
      </entry>
    </users>
    <password-complexity>
      <enabled>yes</enabled>
      <minimum-length>8</minimum-length>
    </password-complexity>
    <devices>
      <entry name="007000000001"/>
      <entry name="007000000002"/>
      <entry name="007000000003"/>
      <entry name="007000000009"/>
    </devices>
  </mgt-config>
  <readonly>
    <dg-meta-data>
      <dg-info>
        <entry name="DG-CHILD"><parent-dg>DG-PARENT</parent-dg></entry>
      </dg-info>
    </dg-meta-data>
  </readonly>
  <shared>
    <address>
      <entry name="sh-web"><ip-netmask>10.1.1.10/32</ip-netmask></entry>
      <entry name="dup-web"><ip-netmask>10.1.1.10/32</ip-netmask></entry>
      <entry name="sh-dns"><ip-netmask>10.1.1.53/32</ip-netmask></entry>
    </address>
    <address-group>
      <entry name="grp-web"><static><member>sh-web</member></static></entry>
    </address-group>
    <service>
      <entry name="tcp-8443"><protocol><tcp><port>8443</port></tcp></protocol></entry>
    </service>
    <profiles>
      <virus><entry name="AV1"><decoder><entry name="http"><action>default</action></entry></decoder></entry></virus>
    </profiles>
    <profile-group>
      <entry name="PG-STD"><virus><member>AV1</member></virus></entry>
    </profile-group>
    <post-rulebase>
      <security>
        <rules>
          <entry name="shared-post-deny">
            <from><member>any</member></from><to><member>any</member></to>
            <source><member>any</member></source><destination><member>any</member></destination>
            <application><member>any</member></application><service><member>any</member></service>
            <action>deny</action><log-end>yes</log-end>
          </entry>
        </rules>
      </security>
    </post-rulebase>
  </shared>
  <devices>
    <entry name="localhost.localdomain">
      <device-group>
        <entry name="DG-PARENT">
          <devices>
            <entry name="007000000001"/>
          </devices>
          <address>
            <entry name="parent-net"><ip-netmask>10.0.0.0/8</ip-netmask></entry>
          </address>
          <pre-rulebase>
            <security>
              <rules>
                <entry name="P-allow-all-apps">
                  <from><member>trust</member></from><to><member>untrust</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <application><member>any</member></application><service><member>application-default</member></service>
                  <action>allow</action><log-end>yes</log-end>
                  <profile-setting><group><member>PG-STD</member></group></profile-setting>
                </entry>
              </rules>
            </security>
          </pre-rulebase>
          <post-rulebase>
            <security>
              <rules>
                <entry name="P-any-any">
                  <from><member>any</member></from><to><member>any</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <application><member>any</member></application><service><member>any</member></service>
                  <action>allow</action>
                </entry>
              </rules>
            </security>
          </post-rulebase>
        </entry>
        <entry name="DG-CHILD">
          <devices>
            <entry name="007000000002"/>
            <entry name="007000000003"/>
          </devices>
          <address>
            <entry name="sh-web"><ip-netmask>10.99.0.10/32</ip-netmask></entry>
            <entry name="unused-1"><ip-netmask>10.50.0.1/32</ip-netmask></entry>
            <entry name="unused-2"><ip-netmask>10.50.0.2/32</ip-netmask></entry>
            <entry name="unused-3"><ip-netmask>10.50.0.3/32</ip-netmask></entry>
            <entry name="unused-4"><ip-netmask>10.50.0.4/32</ip-netmask></entry>
            <entry name="unused-5"><ip-netmask>10.50.0.5/32</ip-netmask></entry>
          </address>
          <pre-rulebase>
            <security>
              <rules>
                <entry name="C-block-p2p">
                  <from><member>trust</member></from><to><member>untrust</member></to>
                  <source><member>any</member></source><destination><member>any</member></destination>
                  <application><member>bittorrent</member></application><service><member>application-default</member></service>
                  <action>deny</action><log-end>yes</log-end>
                </entry>
                <entry name="C-no-profile">
                  <from><member>trust</member></from><to><member>dmz</member></to>
                  <source><member>parent-net</member></source><destination><member>sh-dns</member></destination>
                  <application><member>dns</member></application><service><member>application-default</member></service>
                  <action>allow</action><log-end>no</log-end>
                </entry>
                <entry name="C-app-any-no-profile">
                  <from><member>untrust</member></from><to><member>dmz</member></to>
                  <source><member>parent-net</member></source><destination><member>sh-web</member></destination>
                  <application><member>any</member></application><service><member>tcp-8443</member></service>
                  <action>allow</action><log-end>yes</log-end>
                </entry>
                <entry name="C-needs-sibling">
                  <from><member>trust</member></from><to><member>dmz</member></to>
                  <source><member>lonely-only</member></source><destination><member>sh-dns</member></destination>
                  <application><member>dns</member></application><service><member>application-default</member></service>
                  <action>allow</action><log-end>yes</log-end>
                  <profile-setting><group><member>PG-STD</member></group></profile-setting>
                </entry>
                <entry name="C-edl-block">
                  <from><member>untrust</member></from><to><member>any</member></to>
                  <source><member>panw-known-ip-list</member></source><destination><member>any</member></destination>
                  <application><member>any</member></application><service><member>any</member></service>
                  <action>deny</action><log-end>yes</log-end>
                </entry>
                <entry name="C-targeted">
                  <target><devices><entry name="007000000002"/><entry name="009999999999"/></devices></target>
                  <from><member>trust</member></from><to><member>dmz</member></to>
                  <source><member>parent-net</member></source><destination><member>grp-web</member></destination>
                  <application><member>ssl</member></application><service><member>tcp-8443</member></service>
                  <action>allow</action><log-end>yes</log-end>
                  <profile-setting><group><member>PG-STD</member></group></profile-setting>
                  <disabled>no</disabled>
                </entry>
              </rules>
            </security>
            <nat>
              <rules>
                <entry name="C-nat-out">
                  <from><member>trust</member></from><to><member>untrust</member></to>
                  <source><member>parent-net</member></source><destination><member>any</member></destination>
                  <service>any</service>
                  <source-translation><dynamic-ip-and-port><interface-address><interface>ethernet1/1</interface></interface-address></dynamic-ip-and-port></source-translation>
                </entry>
              </rules>
            </nat>
          </pre-rulebase>
        </entry>
        <entry name="DG-LONELY">
          <address>
            <entry name="lonely-only"><ip-netmask>172.31.0.1/32</ip-netmask></entry>
          </address>
        </entry>
      </device-group>
      <template>
        <entry name="TPL-BASE">
          <config>
            <devices>
              <entry name="localhost.localdomain">
                <network>
                  <interface>
                    <ethernet>
                      <entry name="ethernet1/1">
                        <layer3><ip><entry name="$wan_ip"/></ip></layer3>
                        <comment>DEMO-ISP-1 - Gi0/1</comment>
                      </entry>
                      <entry name="ethernet1/2">
                        <layer3><ip><entry name="10.10.0.1/24"/></ip></layer3>
                      </entry>
                    </ethernet>
                  </interface>
                  <virtual-router>
                    <entry name="default">
                      <interface><member>ethernet1/1</member><member>ethernet1/2</member></interface>
                      <routing-table><ip><static-route>
                        <entry name="default-route"><destination>0.0.0.0/0</destination><nexthop><ip-address>192.0.2.1</ip-address></nexthop><interface>ethernet1/1</interface></entry>
                      </static-route></ip></routing-table>
                    </entry>
                  </virtual-router>
                  <profiles>
                    <interface-management-profile>
                      <entry name="mgmt-open"><telnet>yes</telnet><ssh>yes</ssh></entry>
                    </interface-management-profile>
                  </profiles>
                </network>
                <deviceconfig>
                  <system>
                    <service><disable-telnet>no</disable-telnet></service>
                    <snmp-setting><access-setting><version><v2c><snmp-community-string>CANARYsnmpcommunity77</snmp-community-string></v2c></version></access-setting></snmp-setting>
                  </system>
                </deviceconfig>
                <vsys>
                  <entry name="vsys1">
                    <zone>
                      <entry name="trust"><network><layer3><member>ethernet1/2</member></layer3></network></entry>
                      <entry name="untrust"><network><layer3><member>ethernet1/1</member></layer3></network></entry>
                    </zone>
                    <user-id-collector>
                      <server-monitor><entry name="dc1"><host>10.1.1.1</host><wmi-password>CANARYwmipassword88</wmi-password></entry></server-monitor>
                    </user-id-collector>
                  </entry>
                </vsys>
              </entry>
            </devices>
          </config>
          <variable>
            <entry name="$wan_ip"><type><ip-netmask>192.0.2.2/30</ip-netmask></type></entry>
          </variable>
        </entry>
        <entry name="TPL-DC">
          <config>
            <devices>
              <entry name="localhost.localdomain">
                <network>
                  <interface>
                    <ethernet>
                      <entry name="ethernet1/2">
                        <layer3><ip><entry name="10.20.0.1/24"/></ip></layer3>
                      </entry>
                    </ethernet>
                  </interface>
                </network>
              </entry>
            </devices>
          </config>
        </entry>
        <entry name="TPL-ORPHAN">
          <config><devices><entry name="localhost.localdomain"><deviceconfig><system><hostname>orphan</hostname></system></deviceconfig></entry></devices></config>
        </entry>
      </template>
      <template-stack>
        <entry name="STK-A">
          <templates><member>TPL-DC</member><member>TPL-BASE</member></templates>
          <devices><entry name="007000000001"/><entry name="007000000002"/></devices>
          <settings><default-vsys>vsys1</default-vsys></settings>
        </entry>
        <entry name="STK-B">
          <templates><member>TPL-BASE</member><member>TPL-MISSING</member></templates>
          <devices><entry name="007000000003"/></devices>
        </entry>
        <entry name="STK-EMPTY">
          <templates><member>TPL-BASE</member></templates>
        </entry>
      </template-stack>
    </entry>
  </devices>
</config>
